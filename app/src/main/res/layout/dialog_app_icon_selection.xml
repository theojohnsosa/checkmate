<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/dialog_rounded_background">

    <TextView
        android:text="Select an Icon"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:text="Select an icon to use as your app icon."
        android:textSize="14sp"
        android:textColor="#828282"
        android:layout_marginBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center" >

        <FrameLayout
            android:id="@+id/iconButton1"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/icon_selection_bg"
            android:layout_margin="3dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_app_icon_white"
                android:contentDescription="White Icon"
                android:scaleType="centerInside" />

            <ImageView
                android:id="@+id/checkmark1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_checkmark"
                android:contentDescription="Selected"
                android:visibility="gone" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/iconButton2"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/icon_selection_bg"
            android:layout_margin="3dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_app_icon_blue"
                android:contentDescription="Blue Icon"
                android:scaleType="centerInside" />

            <ImageView
                android:id="@+id/checkmark2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_checkmark"
                android:contentDescription="Selected"
                android:visibility="gone" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/iconButton3"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/icon_selection_bg"
            android:layout_margin="3dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_app_icon_red"
                android:contentDescription="Red Icon"
                android:scaleType="centerInside" />

            <ImageView
                android:id="@+id/checkmark3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_checkmark"
                android:contentDescription="Selected"
                android:visibility="gone" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/iconButton4"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/icon_selection_bg"
            android:layout_margin="3dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_app_icon_yellow"
                android:contentDescription="Yellow Icon"
                android:scaleType="centerInside" />

            <ImageView
                android:id="@+id/checkmark4"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_checkmark"
                android:contentDescription="Selected"
                android:visibility="gone" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/iconButton5"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/icon_selection_bg"
            android:layout_margin="3dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_app_icon_green"
                android:contentDescription="Green Icon"
                android:scaleType="centerInside" />

            <ImageView
                android:id="@+id/checkmark5"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_checkmark"
                android:contentDescription="Selected"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/cancelButton"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="@drawable/dialog_cancel_button"
            android:layout_width="115dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/selectButton"
            android:text="Select"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:background="@drawable/create_account_button"
            android:layout_width="115dp"
            android:layout_height="wrap_content" />

    </LinearLayout>

</LinearLayout>