<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F0F"
    android:fitsSystemWindows="true"
    tools:context=".AttendanceStreak">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#FFFFFF">

            <ImageView
                android:id="@+id/header_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:src="@drawable/header_logo"
                android:contentDescription="header_logo" />

            <ImageView
                android:id="@+id/hamburger_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:src="@drawable/hamburger_icon"
                android:contentDescription="hamburger_icon" />
        </RelativeLayout>

        <!-- Back Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/left_arrow"
                android:drawablePadding="10dp"
                android:text="Back"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attendance Streak"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:layout_marginLeft="4sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View longest and current attendance streak for classes"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginLeft="4sp"
                    android:layout_marginBottom="20dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:layout_marginLeft="13sp"
                    android:paddingBottom="5sp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10sp"
                        android:text="SUN"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10sp"
                        android:layout_marginLeft="22sp"
                        android:text="MON"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10sp"
                        android:layout_marginLeft="24sp"
                        android:text="TUE"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10sp"
                        android:layout_marginLeft="25sp"
                        android:text="WED"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10sp"
                        android:layout_marginLeft="24sp"
                        android:text="THU"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10sp"
                        android:layout_marginLeft="29sp"
                        android:text="FRI"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10sp"
                        android:layout_marginLeft="29sp"
                        android:text="SAT"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/sunday_week1"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/monday_week1"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/tuesday_week1"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/wednesday_week1"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/thursday_week1"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/friday_week1"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/saturday_week1"
                        layout="@layout/streak_card" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/sunday_week2"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/monday_week2"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/tuesday_week2"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/wednesday_week2"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/thursday_week2"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/friday_week2"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/saturday_week2"
                        layout="@layout/streak_card" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/sunday_week3"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/monday_week3"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/tuesday_week3"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/wednesday_week3"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/thursday_week3"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/friday_week3"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/saturday_week3"
                        layout="@layout/streak_card" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/sunday_week4"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/monday_week4"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/tuesday_week4"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/wednesday_week4"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/thursday_week4"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/friday_week4"
                        layout="@layout/streak_card" />

                    <include
                        android:id="@+id/saturday_week4"
                        layout="@layout/streak_card" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Streaks are counted only for Present attendance."
                    android:textColor="#888888"
                    android:textSize="14sp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="20dp"
                    android:layout_marginTop="10sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingLeft="5sp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Longest Streak"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/longestStreakNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:paddingRight="15sp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:background="#1A1A1A"
        app:menu="@menu/menu_drawer"
        app:headerLayout="@layout/drawer_header"
        app:itemTextColor="@color/menu_item_color"
        app:itemIconTint="@color/menu_item_color" />
</androidx.drawerlayout.widget.DrawerLayout>