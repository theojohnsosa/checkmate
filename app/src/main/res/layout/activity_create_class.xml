<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F0F"
    android:fitsSystemWindows="true"
    tools:context=".CreateClass">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/header_logo"
            android:contentDescription="header_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/header_logo"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="15dp" />

        <ImageView
            android:id="@+id/hamburger_icon"
            android:contentDescription="hamburger_icon"
            android:src="@drawable/hamburger_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="15dp" />

    </RelativeLayout>

    <LinearLayout
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="30dp"
        android:layout_marginBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" >

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/backButton"
            android:text="Back to Home"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="@color/fui_transparent"
            android:drawableStart="@drawable/left_arrow"
            android:drawablePadding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <LinearLayout
        android:padding="20dp"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent" >

        <TextView
            android:id="@+id/createClassHeader"
            android:text="Create Class"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="30dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/createClassDescription"
            android:text="Set up a new class for your students"
            android:textColor="#828282"
            android:layout_marginBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:padding="10dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent" >

            <EditText
                android:id="@+id/classNameInput"
                android:hint="Class name"
                android:inputType="text"
                android:textColorHint="#6F6F6F"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:padding="20dp"
                android:textSize="16sp"
                android:maxLength="254"
                android:background="@drawable/form_border"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="60dp" />

            <EditText
                android:id="@+id/subjectCodeInput"
                android:hint="Subject code"
                android:inputType="text"
                android:textColorHint="#6F6F6F"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:padding="20dp"
                android:textSize="16sp"
                android:maxLength="254"
                android:background="@drawable/form_border"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="60dp" />

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" >

                <ToggleButton
                    android:id="@+id/monToggle"
                    android:textOn="Mon"
                    android:textOff="Mon"
                    android:textColor="#6F6F6F"
                    android:textSize="16dp"
                    android:background="@drawable/toggle_buttons"
                    android:textAllCaps="false"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="60dp" />

                <ToggleButton
                    android:id="@+id/tueToggle"
                    android:textOn="Tue"
                    android:textOff="Tue"
                    android:textColor="#6F6F6F"
                    android:textSize="16dp"
                    android:background="@drawable/toggle_buttons"
                    android:textAllCaps="false"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="60dp" />

                <ToggleButton
                    android:id="@+id/wedToggle"
                    android:textOn="Wed"
                    android:textOff="Wed"
                    android:textColor="#6F6F6F"
                    android:textSize="16dp"
                    android:background="@drawable/toggle_buttons"
                    android:textAllCaps="false"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="60dp" />

                <ToggleButton
                    android:id="@+id/thuToggle"
                    android:textOn="Thu"
                    android:textOff="Thu"
                    android:textColor="#6F6F6F"
                    android:textSize="16dp"
                    android:background="@drawable/toggle_buttons"
                    android:textAllCaps="false"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="60dp" />

                <ToggleButton
                    android:id="@+id/friToggle"
                    android:textOn="Fri"
                    android:textOff="Fri"
                    android:textColor="#6F6F6F"
                    android:textSize="16dp"
                    android:background="@drawable/toggle_buttons"
                    android:textAllCaps="false"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="60dp" />

                <ToggleButton
                    android:id="@+id/satToggle"
                    android:textOn="Sat"
                    android:textOff="Sat"
                    android:textColor="#6F6F6F"
                    android:textSize="16dp"
                    android:background="@drawable/toggle_buttons"
                    android:textAllCaps="false"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="60dp" />

            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" >

                <AutoCompleteTextView
                    android:id="@+id/startTimeInput"
                    android:hint="Start time"
                    android:textColorHint="#6F6F6F"
                    android:textColor="#FFFFFF"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:padding="20dp"
                    android:textSize="16sp"
                    android:maxLength="50"
                    android:background="@drawable/form_border"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="60dp"
                    android:focusable="true"
                    android:cursorVisible="false"
                    android:drawableEnd="@drawable/dropdown_icon" />

                <AutoCompleteTextView
                    android:id="@+id/endTimeInput"
                    android:hint="End time"
                    android:textColorHint="#6F6F6F"
                    android:textColor="#FFFFFF"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:padding="20dp"
                    android:textSize="16sp"
                    android:maxLength="50"
                    android:background="@drawable/form_border"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_height="60dp"
                    android:focusable="true"
                    android:cursorVisible="false"
                    android:drawableEnd="@drawable/dropdown_icon"/>

            </LinearLayout>

            <EditText
                android:id="@+id/roomInput"
                android:hint="Room"
                android:inputType="text"
                android:textColorHint="#6F6F6F"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:padding="20dp"
                android:textSize="16sp"
                android:maxLength="254"
                android:background="@drawable/form_border"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="60dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/createClassButton"
                android:text="Create New Class"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:background="@drawable/create_account_button"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="60dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>