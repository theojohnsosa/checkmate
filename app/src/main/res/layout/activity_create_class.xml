<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#FFFFFF">

            <ImageView
                android:id="@+id/header_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:src="@drawable/header_logo"
                android:contentDescription="Logo" />

            <ImageView
                android:id="@+id/hamburger_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:src="@drawable/hamburger_icon"
                android:contentDescription="Menu" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="15dp" >

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/left_arrow"
                android:drawablePadding="10dp"
                android:text="Back"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="0dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="0dp">

                <TextView
                    android:id="@+id/createClassHeader"
                    android:text="Create Class"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="30sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/createClassDescription"
                    android:text="Set up a new class for your students"
                    android:textColor="#828282"
                    android:textAlignment="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="15dp" />

                <EditText
                    android:id="@+id/classNameInput"
                    android:hint="Class name"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textColorHint="#6F6F6F"
                    android:background="@drawable/form_border"
                    android:padding="20dp"
                    android:singleLine="true"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/subjectCodeInput"
                    android:hint="Subject code"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textColorHint="#6F6F6F"
                    android:background="@drawable/form_border"
                    android:padding="20dp"
                    android:singleLine="true"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <ToggleButton
                        android:id="@+id/monToggle"
                        android:textOn="Mon"
                        android:textOff="Mon"
                        android:background="@drawable/toggle_buttons"
                        android:textColor="#6F6F6F"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:textAllCaps="false"
                        android:layout_marginEnd="5dp"/>

                    <ToggleButton
                        android:id="@+id/tueToggle"
                        android:textOn="Tue"
                        android:textOff="Tue"
                        android:background="@drawable/toggle_buttons"
                        android:textColor="#6F6F6F"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:textAllCaps="false"
                        android:layout_marginEnd="5dp"/>

                    <ToggleButton
                        android:id="@+id/wedToggle"
                        android:textOn="Wed"
                        android:textOff="Wed"
                        android:background="@drawable/toggle_buttons"
                        android:textColor="#6F6F6F"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:textAllCaps="false"
                        android:layout_marginEnd="5dp"/>

                    <ToggleButton
                        android:id="@+id/thuToggle"
                        android:textOn="Thu"
                        android:textOff="Thu"
                        android:background="@drawable/toggle_buttons"
                        android:textColor="#6F6F6F"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:textAllCaps="false"
                        android:layout_marginEnd="5dp"/>

                    <ToggleButton
                        android:id="@+id/friToggle"
                        android:textOn="Fri"
                        android:textOff="Fri"
                        android:background="@drawable/toggle_buttons"
                        android:textColor="#6F6F6F"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:textAllCaps="false"
                        android:layout_marginEnd="5dp"/>

                    <ToggleButton
                        android:id="@+id/satToggle"
                        android:textOn="Sat"
                        android:textOff="Sat"
                        android:background="@drawable/toggle_buttons"
                        android:textColor="#6F6F6F"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:textAllCaps="false"/>
                </LinearLayout>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center">

                    <AutoCompleteTextView
                        android:id="@+id/startTimeInput"
                        android:hint="Start time"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textColorHint="#6F6F6F"
                        android:background="@drawable/form_border"
                        android:padding="20dp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="60dp"
                        android:drawableEnd="@drawable/dropdown_icon"/>

                    <AutoCompleteTextView
                        android:id="@+id/endTimeInput"
                        android:hint="End time"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textColorHint="#6F6F6F"
                        android:background="@drawable/form_border"
                        android:padding="20dp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="60dp"
                        android:layout_marginStart="10dp"
                        android:drawableEnd="@drawable/dropdown_icon"/>

                </LinearLayout>

                <EditText
                    android:id="@+id/roomInput"
                    android:hint="Room"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textColorHint="#6F6F6F"
                    android:background="@drawable/form_border"
                    android:padding="20dp"
                    android:singleLine="true"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="10dp"/>


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/createClassButton"
                    android:text="Create New Class"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:background="@drawable/create_account_button"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:padding="20dp"/>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:background="#1A1A1A"
        app:menu="@menu/menu_drawer"
        app:headerLayout="@layout/drawer_header"
        app:itemTextColor="@color/menu_item_color"
        app:itemIconTint="@color/menu_item_color" />

</androidx.drawerlayout.widget.DrawerLayout>