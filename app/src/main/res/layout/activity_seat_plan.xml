<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F"
    android:fitsSystemWindows="true"
    tools:context=".SeatPlan">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:background="#FFFFFF">

            <ImageView
                android:id="@+id/header_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:src="@drawable/header_logo"
                android:contentDescription="header_logo" />

            <ImageView
                android:id="@+id/hamburger_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:src="@drawable/hamburger_icon"
                android:contentDescription="hamburger_icon" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/left_arrow"
                android:drawablePadding="10dp"
                android:text="Back"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="20dp" >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="15dp"
                android:paddingTop="0dp" >

                <TextView
                    android:text="Seat Plan"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="40sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Check Assigned Students"
                    android:textColor="#828282"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal">

                <include
                    android:id="@+id/seatPlanCard1"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard2"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard3"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard4"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard5"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard6"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard7"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard8"
                    layout="@layout/seat_plan_card" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal">

                <include
                    android:id="@+id/seatPlanCard9"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard10"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard11"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard12"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard13"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard14"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard15"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard16"
                    layout="@layout/seat_plan_card" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal">

                <include
                    android:id="@+id/seatPlanCard17"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard18"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard19"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard20"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard21"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard22"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard23"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard24"
                    layout="@layout/seat_plan_card" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal">

                <include
                    android:id="@+id/seatPlanCard25"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard26"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard27"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard28"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard29"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard30"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard31"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard32"
                    layout="@layout/seat_plan_card" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal">

                <include
                    android:id="@+id/seatPlanCard33"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard34"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard35"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard36"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard37"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard38"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard39"
                    layout="@layout/seat_plan_card" />

                <include
                    android:id="@+id/seatPlanCard40"
                    layout="@layout/seat_plan_card" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="10dp"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/occupiedText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Occupied"
                    android:textStyle="bold"
                    android:textColor="#2F9E44"
                    android:textSize="15sp"
                    android:layout_marginRight="40dp"/>

                <TextView
                    android:id="@+id/vacantText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vacant"
                    android:textStyle="bold"
                    android:textColor="#828282"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/falseText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="False"
                    android:textStyle="bold"
                    android:textColor="#004BF9"
                    android:textSize="15sp"
                    android:layout_marginLeft="40dp"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:background="#1A1A1A"
        app:menu="@menu/menu_drawer"
        app:headerLayout="@layout/drawer_header"
        app:itemTextColor="@color/menu_item_color"
        app:itemIconTint="@color/menu_item_color" />

</androidx.drawerlayout.widget.DrawerLayout>