<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/studentAttendanceCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="15dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#D9D9D9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center">

        <TextView
            android:id="@+id/clockIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="🕐"
            android:textAlignment="center"
            android:textSize="48sp"
            android:background="@drawable/rounded_corners"
            android:backgroundTint="#C6C6C7"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/sessionStatusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Active Session"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/sessionStatusDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wait for your teacher to start an attendance session"
            android:textColor="#828282"
            android:textSize="14sp"
            android:textAlignment="center"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/markAttendanceButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Mark Attendance"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/create_account_button"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>