<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F"
    android:fitsSystemWindows="true"
    tools:context=".ShareFeedbackActivity" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#FFFFFF">

            <ImageView
                android:id="@+id/header_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:src="@drawable/header_logo"
                android:contentDescription="header_logo" />

            <ImageView
                android:id="@+id/hamburger_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:src="@drawable/hamburger_icon"
                android:contentDescription="hamburger_icon" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="15dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/left_arrow"
                android:drawablePadding="10dp"
                android:text="Back"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="30dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="30dp" >

                    <TextView
                        android:text="Leave a review"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="40sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="Help us improve your experience"
                        android:textColor="#828282"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- How did Checkmate feel? -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How did Checkmate feel?"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="15dp" />

                <!-- Chips layout using FlexboxLayout (like a grid that wraps) -->
                <com.google.android.flexbox.FlexboxLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:flexWrap="wrap"
                    app:justifyContent="flex_start"
                    app:alignItems="flex_start" >

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/buttonSlow"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:paddingHorizontal="16dp"
                        android:text="Slow"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"
                        android:layout_marginRight="6dp"
                        android:background="@drawable/feedback_button_unselected" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/buttonConfusing"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:paddingHorizontal="16dp"
                        android:text="Confusing"
                        android:textAllCaps="false"
                        android:layout_marginBottom="6dp"
                        android:layout_marginRight="6dp"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:background="@drawable/feedback_button_unselected" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/buttonFast"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:paddingHorizontal="16dp"
                        android:text="Fast"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:background="@drawable/feedback_button_unselected" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/buttonFrustrating"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:paddingHorizontal="16dp"
                        android:text="Frustrating"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="6dp"
                        android:layout_marginRight="6dp"
                        android:textSize="14sp"
                        android:background="@drawable/feedback_button_unselected" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/buttonConvenient"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:paddingHorizontal="16dp"
                        android:text="Convenient"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="6dp"
                        android:layout_marginRight="6dp"
                        android:textSize="14sp"
                        android:background="@drawable/feedback_button_unselected" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/buttonEasyToUse"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:paddingHorizontal="16dp"
                        android:text="Easy to use"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:background="@drawable/feedback_button_unselected" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/buttonReliable"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:paddingHorizontal="16dp"
                        android:text="Reliable"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"
                        android:layout_marginRight="6dp"
                        android:background="@drawable/feedback_button_unselected" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/buttonTimeSaving"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:paddingHorizontal="16dp"
                        android:text="Time-saving"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"
                        android:layout_marginRight="6dp"
                        android:background="@drawable/feedback_button_unselected" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/buttonNeedsImprovement"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:paddingHorizontal="16dp"
                        android:text="Needs improvement"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:background="@drawable/feedback_button_unselected" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/buttonGreatDesign"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:paddingHorizontal="16dp"
                        android:text="Great design"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginRight="6dp"
                        android:background="@drawable/feedback_button_unselected" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/buttonIntuitive"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:paddingHorizontal="16dp"
                        android:text="Intuitive"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginRight="6dp"
                        android:background="@drawable/feedback_button_unselected" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/buttonHelpful"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:paddingHorizontal="16dp"
                        android:text="Helpful"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:background="@drawable/feedback_button_unselected" />

                </com.google.android.flexbox.FlexboxLayout>

                <!-- Rate our service -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rate our service"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="20dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="30dp">

                    <ImageView
                        android:id="@+id/star1"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_star_gray"
                        android:contentDescription="Star 1"
                        android:scaleType="centerInside"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:id="@+id/star2"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_star_gray"
                        android:contentDescription="Star 2"
                        android:scaleType="centerInside"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:id="@+id/star3"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_star_gray"
                        android:contentDescription="Star 3"
                        android:scaleType="centerInside"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:id="@+id/star4"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_star_gray"
                        android:contentDescription="Star 4"
                        android:scaleType="centerInside"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:id="@+id/star5"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/ic_star_gray"
                        android:contentDescription="Star 5"
                        android:scaleType="centerInside"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <!-- Would you recommend Checkmate? -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Would you recommend Checkmate?"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="15dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:id="@+id/recommendationNo"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/feedback_button_unselected"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_thumbs_down_white"
                            android:contentDescription="Thumbs down"
                            android:scaleType="centerInside" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/recommendationYes"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/feedback_button_unselected"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_thumbs_up_white"
                            android:contentDescription="Thumbs up"
                            android:scaleType="centerInside" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Yes"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Can you share more? -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Can you share more?"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="15dp" />

                <EditText
                    android:id="@+id/feedbackTextInput"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="@drawable/feedback_text_input_bg"
                    android:hint="Leave us a feedback..."
                    android:textColorHint="#666666"
                    android:textColor="#FFFFFF"
                    android:padding="16dp"
                    android:textSize="16dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:layout_marginBottom="15dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/submitFeedbackButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="Submit Feedback"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/feedback_submit_button" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:background="#1A1A1A"
        app:menu="@menu/menu_drawer"
        app:headerLayout="@layout/drawer_header"
        app:itemTextColor="@color/menu_item_color"
        app:itemIconTint="@color/menu_item_color" />

</androidx.drawerlayout.widget.DrawerLayout>